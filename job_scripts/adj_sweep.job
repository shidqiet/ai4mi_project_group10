#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=adj-sweep
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=12:00:00
#SBATCH --output=jobs/%x_%A_%a.out

# Run directly; it submits itself as an array of (config x seed) tasks:
#   job_scripts/adj_sweep.job            # seed 0
#   job_scripts/adj_sweep.job 0 1 2      # three seeds
set -euo pipefail

SWEEP=adj_sweep
SEEDS=("${@:-0}")

CONFIGS=()   # "<run_name> <main.py flags>"; JSON must contain no spaces (word-split below)
# unet_k32_lr5e-4 from the arch sweep; n adjacent slices per side -> 2n+1 input channels.
# n=0 is the 2D baseline, rerun because this sweep uses the 30/10 split (arch sweep was 35/5).
for n in 0 1 2 3; do
    CONFIGS+=("unet_k32_lr5e-4_adj${n} --net unet --net_kwargs {\"kernels\":32} --optimizer adam --lr 5e-4 --lr-scheduler polynomial --adjacent_slices ${n}")
done

N_CONFIGS=${#CONFIGS[@]}
if [[ -z ${SLURM_ARRAY_TASK_ID:-} ]]; then
    cd "$(dirname "$0")/.."   # repo root, which becomes SLURM_SUBMIT_DIR
    mkdir -p jobs
    echo ">>> ${N_CONFIGS} configs x ${#SEEDS[@]} seeds"
    exec sbatch --array=1-$(( N_CONFIGS * ${#SEEDS[@]} )) "job_scripts/$(basename "$0")" "$@"
fi

# Tasks 1..N_CONFIGS run the first seed, the next N_CONFIGS the second seed, etc.
i=$(( SLURM_ARRAY_TASK_ID - 1 ))
SEED=${SEEDS[$(( i / N_CONFIGS ))]}
read -r NAME ARGS <<< "${CONFIGS[$(( i % N_CONFIGS ))]}"
DEST="results/segthor/${SWEEP}/${NAME}_s${SEED}"

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$SLURM_SUBMIT_DIR"
source activate ai4mi

echo ">>> ${NAME} (seed ${SEED}) -> ${DEST}"
echo ">>> ${ARGS}"

# ARGS is intentionally unquoted so it splits into separate flags.
python -u main.py \
    --dataset SEGTHOR \
    --mode full \
    --loss dicece \
    --selection-metric dice3d \
    --distance-metrics-at best \
    --epochs 50 \
    --patience 0 \
    --seed "$SEED" \
    --dest "$DEST" \
    --gpu \
    $ARGS
