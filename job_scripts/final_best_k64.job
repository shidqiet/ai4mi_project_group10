#!/bin/bash
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --job-name=final_best_k64
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=18
#SBATCH --time=10:00:00
#SBATCH --output=jobs/%x_%A.out

# Final model: the k64 best_config_eval recipe (2.5D UNet, kernels 64, lr 2.5e-4, 1 adjacent
# slice, augmentation, weight decay 1e-4) trained on all 40 patients (data/SEGTHOR_val0) with
# no validation for a fixed 50 epochs; keeps the last-epoch weights. Submit with:
#   bash job_scripts/final_best_k64.job [seed]
set -euo pipefail

if [[ -z ${SLURM_JOB_ID:-} ]]; then
    cd "$(dirname "$0")/.."
    mkdir -p jobs
    exec sbatch "job_scripts/$(basename "$0")" "$@"
fi

SEED=${1:-0}
RUN_NAME="unet_k64_lr2.5e-4_adj1_aug_s${SEED}"
DEST="results/segthor/final/${RUN_NAME}"

module purge
module load 2025
module load Anaconda3/2025.06-1

cd "$SLURM_SUBMIT_DIR"
source activate ai4mi

echo ">>> Training ${RUN_NAME} on all 40 patients -> ${DEST}"
python -u main.py \
    --dataset SEGTHOR_val0 \
    --no-val \
    --net unet \
    --net_kwargs '{"kernels":64}' \
    --adjacent_slices 1 \
    --mode full \
    --loss dicece \
    --optimizer adam \
    --lr 2.5e-4 \
    --weight-decay 1e-4 \
    --lr-scheduler polynomial \
    --augment \
    --epochs 50 \
    --patience 0 \
    --seed "$SEED" \
    --dest "$DEST" \
    --gpu
