#!/bin/bash
#SBATCH --partition=gpu_mig
#SBATCH --gpus=1
#SBATCH --job-name=submission
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=9
#SBATCH --time=02:00:00
#SBATCH --output=jobs/%x_%A.out

# Assemble the submission folder $HOME/group-10 (the git bundle is made separately).
#   val:  the k64 best_config_eval model (seed 0, trained on 30 patients): postprocessed val
#         predictions, their GT and the 3D metrics.
#   test: the final model (same recipe, all 40 patients): predict, stitch and postprocess the
#         20 test volumes.
# STAGE=val | test | all (default). Test needs tools/data/SEGTHOR_val0/test.
#   sbatch --export=ALL,STAGE=val tools/hpc/submission.job
#   sbatch --dependency=afterok:<final training job> tools/hpc/submission.job
set -euo pipefail

STAGE=${STAGE:-all}
OUT="$HOME/group-10"
LCC_MAX_DIST=50
VAL_RUN="unet_k64_lr2.5e-4_adj1_aug_s0"
VAL_VOLUMES="volumes/lcc${LCC_MAX_DIST}/best_config_eval/${VAL_RUN}"
FINAL_RUN="results/segthor/final/unet_k64_lr2.5e-4_adj1_aug_s0"
TEST_VOLUMES="volumes/lcc${LCC_MAX_DIST}/final/unet_k64_lr2.5e-4_adj1_aug_s0"

module purge
module load 2025
module load Anaconda3/2025.06-1
source activate ai4mi

cd $HOME/ai4mi_project_group10

if [[ $STAGE == val || $STAGE == all ]]; then
    echo ">>> Val: ${VAL_VOLUMES} -> ${OUT}/val"
    rm -rf "$OUT/val"
    mkdir -p "$OUT/val/pred" "$OUT/val/gt"
    cp "$VAL_VOLUMES"/Patient_*.nii.gz "$OUT/val/pred/"
    for pred in "$OUT"/val/pred/Patient_*.nii.gz; do
        id=$(basename "$pred" .nii.gz)
        cp "tools/data/segthor_train_full/train/${id}/GT.nii.gz" "$OUT/val/gt/${id}.nii.gz"
    done
    python -m ai4mi.evaluation.evaluate_volumes \
        --pred_folder "$OUT/val/pred" \
        --gt_pattern "$OUT/val/gt/{id_}.nii.gz" \
        --dest "results/segthor/best_config_eval/${VAL_RUN}/eval_submission" \
        --npz_dir "$OUT/val"
fi

if [[ $STAGE == test || $STAGE == all ]]; then
    echo ">>> Test: predicting with ${FINAL_RUN}/lastmodel.pkl"
    rm -rf "${FINAL_RUN}/test" "$TEST_VOLUMES"
    python -u -m ai4mi.inference.predict \
        --model "${FINAL_RUN}/lastmodel.pkl" \
        --data_root tools/data/SEGTHOR_val0 \
        --subset test \
        --adjacent_slices 1 \
        --dest "${FINAL_RUN}/test" \
        --gpu

    echo ">>> Test: stitching and postprocessing -> ${TEST_VOLUMES}"
    python -m ai4mi.inference.stitch \
        --data_folder "${FINAL_RUN}/test" \
        --dest_folder "$TEST_VOLUMES" \
        --num_classes 255 \
        --grp_regex '(Patient_\d\d)_\d\d\d\d' \
        --source_scan_pattern 'tools/data/segthor_train_full/test/{id_}.nii.gz' \
        --preprocess_stats tools/data/SEGTHOR_val0/preprocess_stats.pkl \
        --lcc \
        --lcc_max_dist "$LCC_MAX_DIST"

    rm -rf "$OUT/test"
    mkdir -p "$OUT/test/pred"
    cp "$TEST_VOLUMES"/Patient_*.nii.gz "$OUT/test/pred/"
    cp "${FINAL_RUN}/lastmodel.pkl" "$OUT/bestmodel-group-10.pkl"
    echo ">>> Test: $(ls "$OUT/test/pred" | wc -l) volumes in ${OUT}/test/pred"
fi

echo ">>> Done"
find "$OUT" -maxdepth 2 | sort
